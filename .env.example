###############################################################################
# GLM Chat Application — Local Development Environment Variables
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
###############################################################################

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL (pgvector)
PGHOST=localhost
PGPORT=5432
PGUSER=glmchat_admin
PGPASSWORD=localdev
PGDATABASE=glmchat

# Service URLs (for running services outside Docker Compose)
EMBEDDING_SERVICE_URL=http://localhost:8001
INFERENCE_SERVICE_URL=http://localhost:8000
SCORER_SERVICE_URL=http://localhost:8003
RAG_SERVICE_URL=http://localhost:8002
